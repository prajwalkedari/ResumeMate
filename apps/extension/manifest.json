{
  "manifest_version": 3,
  "name": "ResumeMate Assistant",
  "version": "0.1.0",
  "description": "Prepare reviewed resume prompts for ResumeMate and use the official Gemini website with your confirmation.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ResumeMate Assistant",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://resumemate.prajwalkedari.tech/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/app*"
      ],
      "js": [
        "content/gemini.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://resumemate.prajwalkedari.tech/*"
      ],
      "js": [
        "content/resumemate.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
